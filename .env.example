# Copy to .env.local (never commit it) or set these in Vercel > Project > Settings > Environment Variables.
# merch.py also reads .env and .env.local, so you only set these once.

# Password for the account settings page.
ADMIN_PASSWORD=
# Encrypts saved email passwords. Make one with: openssl rand -base64 32
# Keep it safe: if you lose it, saved passwords can't be decrypted and you'll re-enter them.
ACCOUNTS_KEY=

# Set automatically when you add an Upstash Redis database in Vercel > Storage.
# Leave blank on your laptop to save accounts to .data/accounts.json instead.
# To let merch.py on your laptop use the accounts saved on Vercel, copy these two from Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Used by merch.py draft.
ANTHROPIC_API_KEY=
# Old way to send (still works if you haven't saved any accounts in the web page).
SMTP_PASSWORD=
